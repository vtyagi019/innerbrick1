# Static hosting headers (Netlify / Cloudflare Pages syntax).
# The site is fully static, so every route is served from the edge/CDN — the
# remaining TTFB cost is origin cold start, which this config avoids by letting
# HTML be cached briefly and revalidated cheaply.

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/*/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
